MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/job-tracker?retryWrites=true&w=majority
PORT=5000

# OAuth client id from Google Cloud Console → APIs & Services → Credentials.
# Must be the same value as the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Signs the session tokens this API issues. Any long random string;
# generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed to call this API. Leave unset in local dev.
CLIENT_ORIGIN=https://your-client.vercel.app
